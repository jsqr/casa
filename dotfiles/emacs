;; Prefer tree-sitter major modes; grammars are provisioned via Nix into
;; ~/.emacs.d/tree-sitter (see home/common.nix). The *-ts-mode each map from
;; the classic mode that auto-mode-alist resolves to. Zig is handled by
;; replacing zig-mode with zig-ts-mode outright.
(dolist (m '((python-mode . python-ts-mode)
             (c-mode      . c-ts-mode)
             (rust-mode   . rust-ts-mode)
             (julia-mode  . julia-ts-mode)))
  (add-to-list 'major-mode-remap-alist m))

;; LSP (built-in eglot)
;; Both classic and -ts variants are listed: rust-ts-mode/c-ts-mode/zig-ts-mode
;; do not derive from their classic modes, so their hooks need explicit entries
;; (julia-ts-mode does derive from julia-mode, listed for symmetry).
(use-package eglot
  :hook (((python-mode python-ts-mode) . eglot-ensure)
         ((julia-mode julia-ts-mode) . eglot-ensure)
         ((rust-mode rust-ts-mode) . eglot-ensure)
         ((zig-mode zig-ts-mode) . eglot-ensure)
         ((c-mode c-ts-mode) . eglot-ensure)
	 (typst-ts-mode . eglot-ensure))
  :config
  (setq eglot-autoshutdown t)
  (add-to-list 'eglot-server-programs
	       '((python-mode python-ts-mode) . ("pyrefly" "lsp"))))

;; Julia
;; major-mode-remap-alist (above) routes buffers to julia-ts-mode, which derives
;; from julia-mode, so julia-mode-map and TAB stay here
(use-package julia-mode
  :bind (:map julia-mode-map
	     ("TAB" . julia-latexsub-or-indent)))

(use-package julia-ts-mode)

;; Julia LSP (LanguageServer.jl) via eglot.
;; Registers the julia entry in eglot-server-programs; without it the
;; (julia-mode . eglot-ensure) hook above eglot with no server program.
(use-package eglot-jl
  :init
  (with-eval-after-load 'eglot
    (require 'eglot-jl)
    (eglot-jl-init))
  :config
  ;; LanguageServer.jl's first precompile can take longer than default
  ;; 30s connect timeout
  (setq eglot-connect-timeout 120))

;; Rust
;; rust-mode provides the .rs association; remap routes buffers to the built-in
;; rust-ts-mode, which does NOT derive from rust-mode, so the hook stays on
;; rust-ts-mode-hook. rust-format-on-save is a rust-mode var with no equivalent
;; in rust-ts-mode; format on save via eglot/rust-analyzer (rustfmt) instead.
(use-package rust-mode
  :config
  (add-hook 'rust-ts-mode-hook
            (lambda ()
              (add-hook 'before-save-hook #'eglot-format-buffer nil t)
              ;; Workaround: Ghostty terminal miscounts columns on
              ;; rust's composed operator glyphs, duplicating lines
              ;; during navigation. Remove once Ghostty fixes it.
              (when (let ((tty (frame-parameter nil 'tty-type)))
                      (and tty (string-match-p "ghostty" tty)))
                (auto-composition-mode -1)))))

;; Zig
;; Classic zig-mode is archived (EOL); zig-ts-mode is the successor.
;; Grammar comes from Nix (~/.emacs.d/tree-sitter). eglot's built-in server list
;; covers zig-ts-mode -> zls
(use-package zig-ts-mode
  :mode "\\.zig\\'")

;; C
;; Remap routes .c/.h to c-ts-mode (derives from prog-mode, not c-mode), which
;; uses its own style/offset vars rather than c-set-style / c-basic-offset.
(setq c-ts-mode-indent-style 'k&r)
(add-hook 'c-ts-mode-hook
          (lambda ()
            (setq c-ts-mode-indent-offset 4)
            (setq indent-tabs-mode nil)))

