(defun jj/set-gui-font (&optional frame)
  (when (and (display-graphic-p frame)
             (member "FiraCode Nerd Font Mono" (font-family-list frame)))
    (set-face-attribute 'default frame
                        :family "FiraCode Nerd Font Mono" :height 130)
    ;; Changing the font preserves pixel size, which would otherwise shift
    ;; the column/row count; re-assert the 120x48 grid in the new font.
    (set-frame-size frame 110 50)))
;; Apply to the current frame (standalone Emacs.app) and to every new
;; frame the daemon creates for emacsclient -c.
(jj/set-gui-font)
(add-hook 'after-make-frame-functions #'jj/set-gui-font)

;; Used at GUI frame creation; jj/set-gui-font re-asserts it after the
;; font swap (above). Covers the initial frame and emacsclient -c.
(add-to-list 'default-frame-alist '(width . 110))
(add-to-list 'default-frame-alist '(height . 50))

