;; Load shell-style secrets into Emacs's process environment
(let ((secrets (expand-file-name "~/.secrets")))
  (when (file-readable-p secrets)
    (with-temp-buffer
      (insert-file-contents secrets)
      (goto-char (point-min))
      (while (re-search-forward
              "^\\(?:export[ \t]+\\)?\\([A-Za-z_][A-Za-z0-9_]*\\)=\\(.*\\)$"
              nil t)
        (let ((key (match-string 1))
              (val (string-trim (match-string 2) "[\"']" "[\"']")))
          (setenv key val))))))

;; Packages are provided by Nix (programs.emacs.extraPackages in
;; home/common.nix), so they're already on the load-path — no package.el /
;; MELPA, and use-package forms below carry no :ensure/:vc.
;; package.el still auto-initializes, so M-x package-install remains available
;; for ad-hoc use after a manual package-refresh-contents.
(require 'use-package)
